# Build output from the visual editor (`python planner.py ui`)
out/

# Local default config for direct CLI/UI use outside the stage pipeline
# (`python planner.py build` reads ./family.yaml if it exists). Each run's
# canonical config lives in stages/02-customize/output/ instead.
/family.yaml

# Per-run pipeline outputs carry a real family's name and members. They stay
# on this machine; only the empty folders (.gitkeep) are tracked. Personalise
# a book through family.yaml or the UI, never by committing a run.
stages/*/output/*
!stages/*/output/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
